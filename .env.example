# Your Kindroid API key (found in Kindroid > Settings > API)
KINDROID_API_KEY=your_api_key_here

# (Required for remote/Railway deployment) OAuth client credentials.
# Choose any values you like (e.g. "my-kindroid-client" / "my-secret-123").
# Enter the same values in Claude.ai's Advanced Settings when adding the connector.
# Leave unset for local stdio mode (or to run without auth).
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
