{
  "name": "kindroid-mcp-server",
  "version": "1.2.0",
  "description": "MCP server for the Kindroid AI API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "kindroid-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "mcpb:validate": "mcpb validate .",
    "mcpb:pack": "npm run build && npm prune --omit=dev && npx --yes @anthropic-ai/mcpb pack . && npm install"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
